{
  "name": "@impulsedev/wiki",
  "version": "0.2.2",
  "description": "Personal Wikipedia CLI",
  "main": "dist/cli.js",
  "preferGlobal": true,
  "bin": {
    "wiki": "dist/cli.js"
  },
  "files": [
    "dist",
    "update",
    "public",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImpulseDoes/wiki.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/cli.ts",
    "dev": "ts-node src/cli.ts",
    "index": "ts-node src/indexer.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "wikipedia",
    "typescript",
    "tool"
  ],
  "author": "impulsedoes",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/marked": "^5.0.2",
    "@types/node": "^25.6.0",
    "@types/jsdom": "^28.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "marked": "^18.0.3",
    "node-html-markdown": "^2.0.0",
    "ora": "^5.4.1",
    "terminal-link": "^2.1.1",
    "jsdom": "^29.1.1"
  }
}